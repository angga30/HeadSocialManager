# Semua setting aplikasi memakai prefix HEADSOF_ (lihat src/headofsocial/config.py).

# --- Storage ---
HEADSOF_APP_NAME=headofsocial
HEADSOF_DB_URL=sqlite+aiosqlite:///./data/headofsocial.db
HEADSOF_DATA_DIR=./data

# --- LLM role map (LiteLLM model strings) ---
# Docs: https://docs.litellm.ai/docs/providers
# Contoh pakai OpenRouter (satu key, banyak model): prefix "openrouter/", key OPENROUTER_API_KEY.
HEADSOF_LLM_ROLE_POSITIONING=openrouter/deepseek/deepseek-v4-flash
HEADSOF_LLM_ROLE_PLANNING=openrouter/deepseek/deepseek-v4-flash
HEADSOF_LLM_ROLE_CONTENT=openrouter/qwen/qwen3-30b-a3b-instruct-2507
HEADSOF_LLM_ROLE_PUBLISHING=openrouter/openai/gpt-oss-20b
HEADSOF_LLM_ROLE_ORCHESTRATOR=openrouter/openai/gpt-oss-120b
HEADSOF_LLM_ROLE_DEFAULT=openrouter/openai/gpt-oss-20b

# Contoh pakai provider langsung (tanpa OpenRouter):
# HEADSOF_LLM_ROLE_DEFAULT=gemini/gemini-3-flash-preview
# HEADSOF_LLM_ROLE_CONTENT=openai/gpt-4o

# --- Media budget (hard caps per asset) ---
HEADSOF_MAX_IMAGES_PER_ASSET=5
HEADSOF_MAX_VIDEOS_PER_ASSET=2

# --- Media provider (mock | litellm) ---
# mock: placeholder paths, no network (default). litellm: real image generation.
HEADSOF_MEDIA_PROVIDER=mock
# Image model (LiteLLM string) used when HEADSOF_MEDIA_PROVIDER=litellm.
# Examples: gemini/imagen-3.0-generate-002 | openai/gpt-image-1 | vertex_ai/imagen-3.0-generate-002
HEADSOF_MEDIA_IMAGE_MODEL=gemini/imagen-3.0-generate-002
# Optional image size, e.g. 1024x1024 (empty = provider default).
HEADSOF_MEDIA_IMAGE_SIZE=

# --- Provider API keys (dibaca langsung oleh LiteLLM; tanpa prefix) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# GOOGLE_API_KEY=AIza...
# GOOGLE_GENAI_USE_VERTEXAI=False